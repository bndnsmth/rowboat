{
  "business": "Northstar Supply",
  "database": "PostgreSQL 18 / northstar",
  "query": "-- October orders \u00b7 Northstar Supply\nSELECT order_number,\n       customer,\n       status,\n       total, currency,\n       region, channel,\n       placed_at::date AS ordered_on\nFROM public.orders\nWHERE placed_at >= DATE '2026-10-01'\nORDER BY placed_at DESC, order_number DESC\nLIMIT 100;\n",
